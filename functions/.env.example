# Public reCAPTCHA Enterprise site key already registered in Firebase App Check.
# Copy to .env.<firebase-project-id> for a production deployment.
APP_CHECK_SITE_KEY=
# Optional initial owner. Administrative access requires a verified Firebase Auth email.
OWNER_EMAIL=

# Leave disabled until prices/conditions are approved and sandbox purchases pass.
PAYMENTS_MODE=disabled
# Explicitly enable new purchases only after the provider integration passes.
# Pausing checkout preserves signed notifications and pending-payment recovery.
PAYMENTS_CHECKOUT_ENABLED=false
# Optional test checkout for verified administrators only, never in live mode.
PAYMENTS_SANDBOX_ADMIN=false
MERCADO_PAGO_COLLECTOR_ID=
# Store MERCADO_PAGO_ACCESS_TOKEN and MERCADO_PAGO_WEBHOOK_SECRET in Secret Manager.
# In local emulators payments are always simulated; no provider request is made.
PRICE_EVENT_1_CENTS=6500000
PRICE_PACK_3_CENTS=17550000
# Ten events are quotation only; a forged order cannot purchase this plan.
EVENT_PHOTO_LIMIT=3000
EVENT_RECEPTION_HOURS=48
EVENT_DOWNLOAD_DAYS=30

# Transactional messages: disabled until sender configuration is tested.
# Local emulators always save a private preview and never send mail.
MAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
MAIL_FROM=
# Store SMTP_PASSWORD in Secret Manager, never in this file or in Git.

# Terms approved: 48 hours reception + 30 days download. Frozen into NEW purchases.
# Enable deletion only after testing the real sender and expiry notices.
RETENTION_CLEANUP=disabled
# Terms version: retencion-avisada-v1. Previous events without it are excluded.
